{
  "manifest_version": 3,
  "name": "Job Copilot",
  "version": "0.2.0",
  "description": "Fills job application forms from your Job Copilot profile for you to review. It never clicks Submit.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Copilot"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": ["content/capture.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": ["https://job-copilot-arina-ovcharenkos-projects.vercel.app/*", "http://localhost:3000/*"]
  }
}
